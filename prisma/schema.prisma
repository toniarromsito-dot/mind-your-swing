// Mind Your Swing — Prisma schema
// Postgres in production; see README for local dev options.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth.js (NextAuth) models ----------
// Required shape for @auth/prisma-adapter.

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Puente de sesión para la app nativa (Capacitor). Google fuerza el login
// fuera del WebView de la app (política anti-webview de OAuth) y lo
// completa en el navegador del sistema; este token de un solo uso deja
// volver a la app ya con sesión iniciada sin exponer el sessionToken real
// en un deep link. Ver /mobile-bridge y /api/mobile/session.
model MobileHandoff {
  token        String   @id @default(cuid())
  sessionToken String
  expires      DateTime

  @@index([expires])
}

// ---------- Domain models ----------

// Cómo se comunica el compañero. Reemplaza al antiguo CERCANO/FORMAL: el
// producto ahora se vende como "tu compañero de golf", así que las
// personalidades son más expresivas que un simple tono formal/informal.
enum CoachTone {
  CALM
  MOTIVATOR
  COACH
  FRIEND
}

enum GameStatus {
  IN_PROGRESS
  COMPLETED
}

// Modos de juego. Uno por concepto, no uno por número de jugadores: la
// misma FRIENDLY_CHALLENGE es "Reto amistoso" a 2, "Mini retos" a 3 y
// "Retos amistosos" a 4 — solo cambia la etiqueta (ver dictionaries.ts),
// no la lógica (ver src/lib/games/standings.ts).
enum GameMode {
  SOLO
  STROKE_PLAY
  MATCH_PLAY
  DUEL
  FRIENDLY_CHALLENGE
  EVERYONE_VS_EVERYONE
  POINTS
  TWO_VS_TWO
  BEST_BALL
  SCRAMBLE
  TEAM_DUEL
}

enum Team {
  A
  B
}

enum Mood {
  TRANQUILO
  NERVIOSO
  FRUSTRADO
  CONFIADO
  CONCENTRADO
}

enum MessageRole {
  USER
  ASSISTANT
}

enum Plan {
  FREE
  PRO
}

// ---------- Suscripción / entitlement (Fase 11B — Subscription Foundation) ----------
// Stripe es el único proveedor implementado hoy. El enum deja sitio a
// futuros proveedores (Apple/Google) sin forzar un rediseño: cuando lleguen,
// se añaden como nuevos valores, nunca como una tabla paralela.
enum SubscriptionProvider {
  STRIPE
}

// Normaliza los `status` de Stripe (incomplete/incomplete_expired/trialing/
// active/past_due/canceled/unpaid, y el más reciente "paused") a un conjunto
// propio y estable — así ningún caller depende de los strings exactos que
// use el proveedor. Ver normalizeStripeStatus() en src/lib/stripe.ts.
enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  UNPAID
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

enum SwingVideoStatus {
  PENDING
  REVIEWED
}

// ---------- Torneos — Fase A (identidad competitiva + participación) ----------
// Ver docs de arquitectura de la sesión: el torneo puede organizarse fuera de
// MYS (campo/club/federación); estos enums son deliberadamente los mínimos
// aprobados para esta fase — el cálculo de posición, el cierre y el hándicap
// conectado llegan en fases posteriores.

enum TournamentSource {
  MANUAL
  IMPORTED
  CLUB_SYNC
  EXTERNAL_PROVIDER
}

enum TournamentStatus {
  DRAFT
  REGISTRATION_OPEN
  IN_PROGRESS
  FINISHED
  CANCELLED
}

enum TournamentParticipantStatus {
  REGISTERED
  CANCELLED
  NO_SHOW
  REMOVED
}

/// Confianza del enlace entre un TournamentParticipant y su PlayerProfile/User
/// — nunca se sube a LICENSE_VERIFIED automáticamente por nombre+club.
enum IdentityConfidence {
  UNVERIFIED
  PLAYER_CONFIRMED
  LICENSE_VERIFIED
}

enum TournamentResultStatus {
  PROVISIONAL
  FINAL
  DISQUALIFIED
}

enum LicenseVerificationStatus {
  UNVERIFIED
  SELF_DECLARED
  VERIFIED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  handicap  Float?
  /// Club autodeclarado por el jugador — distinto de PlayerProfile.club
  /// (competitivo, solo se crea vía el futuro importador de torneos). Este
  /// campo es el que usa Comunidad para la pestaña "Club".
  club      String?
  coachTone CoachTone @default(FRIEND)
  language  String    @default("es")

  // Memoria persistente de Mind (solo Pro) — un párrafo corto que se
  // reescribe tras cada partida, no un historial completo. Ver
  // src/actions/games.ts (updateMindMemory) y coach/context.ts.
  mindMemory String? @db.Text

  // plan es un resumen/caché derivado de Subscription (ver hasProAccess() en
  // src/lib/plan.ts) — nunca se escribe a mano fuera del sync de webhook.
  // Se mantiene aquí (en vez de solo en Subscription) para no obligar a un
  // JOIN en cada comprobación de acceso Pro.
  plan Plan @default(FREE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription  Subscription?
  accounts      Account[]
  sessions      Session[]
  gamePlayers   GamePlayer[]
  moodEntries   MoodEntry[]
  messages      Message[]
  stories       Story[]
  voiceCallLogs VoiceCallLog[]
  voiceCreditPeriods    VoiceCreditPeriod[]
  voicePurchasedBalance VoicePurchasedBalance?
  swingVideos   SwingVideo[]
  swingAiCreditPeriods SwingAiCreditPeriod[]
  playerProfile PlayerProfile?
  likes         Like[]
  comments      Comment[]
  following     Follow[]       @relation("Following")
  followers     Follow[]       @relation("Followers")
  challengeParticipations ChallengeParticipant[]

  /// Torneos que este usuario organiza (Tournament.organizerId) — ver Fase A.
  organizedTournaments Tournament[] @relation("TournamentOrganizer")
  /// Auditoría mínima de quién resolvió/corrigió el enlace identidad↔participante
  /// de un TournamentParticipant (rematching) — ver Fase A.
  matchedTournamentParticipants TournamentParticipant[] @relation("TournamentParticipantMatchedBy")
}

/**
 * Una fila por usuario (relación 1:1 real, ver @unique en userId) con el
 * estado de su suscripción en el proveedor de pago. `User.plan` es el
 * resumen derivado que lee hasProAccess(); esta tabla es la fuente de
 * verdad de la que ese resumen se recalcula (ver syncSubscription() en
 * src/app/api/stripe/webhook/route.ts).
 *
 * hasUsedTrial vive aquí (no en User) porque es un hecho ligado al ciclo de
 * vida de ESTA suscripción, no a la cuenta en abstracto: una vez concedido
 * el trial de 3 días, queda marcado para siempre y ningún checkout
 * posterior (mismo usuario, mismo Stripe customer) puede volver a
 * concederlo — cerrar sesión, cambiar de dispositivo o crear otra sesión de
 * checkout no lo reinician porque nada de eso toca esta fila.
 *
 * lastEventAt guarda el `created` (timestamp) del último evento de webhook
 * aplicado — permite descartar un evento que llegue más tarde pero
 * represente un estado más antiguo (entrega fuera de orden), sin depender
 * de que Stripe garantice el orden de entrega.
 */
model Subscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider                SubscriptionProvider @default(STRIPE)
  providerCustomerId      String               @unique
  providerSubscriptionId  String?              @unique
  status                  SubscriptionStatus   @default(INCOMPLETE)
  billingInterval         BillingInterval?
  priceId                 String?
  currentPeriodEnd        DateTime?
  cancelAtPeriodEnd       Boolean              @default(false)
  trialEnd                DateTime?
  hasUsedTrial            Boolean              @default(false)
  lastEventAt             DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events SubscriptionEvent[]
}

/**
 * Histórico inmutable de eventos de webhook ya procesados. providerEventId
 * es único a propósito: es el mecanismo real de idempotencia — un evento
 * reentregado por Stripe (mismo event.id) choca contra esa restricción y el
 * webhook lo trata como ya procesado sin volver a aplicar cambios. Nunca se
 * actualiza ni se borra una fila existente, solo se insertan nuevas.
 */
model SubscriptionEvent {
  id              String   @id @default(cuid())
  provider        SubscriptionProvider
  providerEventId String   @unique
  eventType       String
  receivedAt      DateTime @default(now())
  rawPayload      Json

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([subscriptionId])
}

/**
 * Grafo social simple: A sigue a B. Sin aprobación ni privacidad — seguir
 * es público, como en la mayoría de apps deportivas. followerId = quien
 * sigue, followingId = a quien sigue.
 */
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

// Identidad competitiva de un jugador — deliberadamente separada de User:
// una partida casual de Mind Your Swing (Game/GamePlayer/Score) NUNCA
// crea ni modifica un PlayerProfile. Solo lo hace la futura integración
// de torneos (ver TournamentResult, y src/lib/data/players.ts). userId es
// opcional y único: permite que un PlayerProfile exista antes de que esa
// persona tenga cuenta en la app (importado de un torneo), y que más
// adelante se enlace a su User cuando se identifique / inicie sesión.
model PlayerProfile {
  id        String  @id @default(cuid()) // el "playerId" estable
  firstName String
  lastName  String
  club      String?
  handicap  Float? // hándicap oficial/competitivo actual — distinto del
  // User.handicap autodeclarado que ya existe para el juego casual

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  /// Participaciones en torneos (Fase A) — el resultado de cada una cuelga de
  /// TournamentParticipant.results, no directamente de aquí: TournamentResult
  /// ya no tiene una relación propia a PlayerProfile (ver TournamentResult).
  participations       TournamentParticipant[]
  handicapHistory       HandicapEntry[]
  /// Identidad federativa (licencia) — modelo preparado, sin ningún proveedor
  /// integrado todavía. Ver FederationIdentity.
  federationIdentities  FederationIdentity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Heurística de emparejamiento para una futura importación (nombre +
  // apellidos + club) mientras no exista un identificador federativo real.
  @@index([lastName, firstName])
}

/// El torneo puede nacer dentro de MYS (source=MANUAL) o fuera (importado,
/// sincronizado desde el software de un club, o —en el futuro— integrado
/// directamente con una federación). Ver docs de arquitectura de Torneos.
model Tournament {
  id           String   @id @default(cuid())
  name         String
  course       String
  golfCourseId String?
  date         DateTime
  /// Texto libre: "Stableford Individual", "Medal Play", "Parejas Better Ball"...
  format       String?

  status TournamentStatus @default(DRAFT)
  source TournamentSource @default(MANUAL)
  /// Solo se rellenan cuando source != MANUAL — el par identifica el torneo
  /// de forma estable en el sistema de origen (idempotencia de una futura
  /// sincronización, ver Fase H).
  externalProvider String?
  externalId       String?
  /// Si el torneo divide su clasificación en categorías. Opcional a
  /// propósito: la mayoría de torneos amateur no las tienen.
  hasCategories Boolean @default(false)
  /// Responsable del torneo dentro de MYS — opcional porque un torneo
  /// importado/sincronizado puede no tener todavía ningún User de MYS
  /// gestionándolo. Sin sistema de permisos todavía (ver Fase E).
  organizerId String?

  golfCourse   GolfCourse?             @relation(fields: [golfCourseId], references: [id])
  organizer    User?                   @relation("TournamentOrganizer", fields: [organizerId], references: [id])
  results      TournamentResult[]
  participants TournamentParticipant[]
  createdAt    DateTime                @default(now())

  @@unique([externalProvider, externalId])
}

/// Sustituye conceptualmente a TournamentRegistration: representa "esta
/// persona forma parte oficialmente de este torneo", venga de donde venga
/// esa lista (autoinscripción, importación, sincronización...). Cuelga
/// siempre de un PlayerProfile — nunca directamente de un User, porque un
/// participante puede existir sin cuenta de MYS todavía.
model TournamentParticipant {
  id              String @id @default(cuid())
  tournamentId    String
  playerProfileId String

  status             TournamentParticipantStatus @default(REGISTERED)
  /// Confianza del enlace con el PlayerProfile — nunca LICENSE_VERIFIED por
  /// una heurística de nombre; solo por licencia real o confirmación propia
  /// del jugador (ver Fase A, "matching / claim").
  identityConfidence IdentityConfidence          @default(UNVERIFIED)
  /// Categoría en la que compite (solo relevante si Tournament.hasCategories).
  category           String?

  /// Referencia a la vuelta oficial de ESTE participante — deliberadamente
  /// SIN relación Prisma a Game todavía (ver nota de Fase A más abajo): el
  /// modelo Game no se toca en esta fase. Se conectará como relación real
  /// en la Fase C junto con Game.tournamentId.
  gameId String? @unique

  /// Id de este participante en el sistema de origen, si vino importado.
  externalParticipantId String?

  /// Trazabilidad mínima de un rematching (desvincular/re-vincular la
  /// identidad) — quién y cuándo, sin tabla de auditoría dedicada todavía.
  matchedAt       DateTime?
  matchedByUserId String?

  createdAt DateTime @default(now())

  tournament    Tournament          @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  playerProfile PlayerProfile       @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)
  matchedByUser User?               @relation("TournamentParticipantMatchedBy", fields: [matchedByUserId], references: [id])
  results       TournamentResult[]

  @@unique([tournamentId, playerProfileId])
  @@unique([tournamentId, externalParticipantId])
  @@index([tournamentId, status])
}

/// El resultado oficial de UN participante en UN torneo — lo único que
/// construye "historial competitivo oficial". Cuelga de TournamentParticipant
/// (nunca directamente de PlayerProfile): la identidad ya vive en el
/// participante, no se duplica aquí. gameId es opcional y de trazabilidad —
/// un resultado importado/manual puede no tener ninguna Game de MYS detrás.
model TournamentResult {
  id            String @id @default(cuid())
  tournamentId  String
  participantId String

  /// Vuelta de MYS que originó este resultado, si la hay. Sin relación
  /// Prisma a Game todavía por el mismo motivo que TournamentParticipant.gameId
  /// (ver nota de Fase A) — se conecta de verdad en la Fase C.
  gameId String? @unique

  strokes          Int? // bruto
  netScore         Int?
  stablefordPts    Int?
  resultLabel      String? // texto libre para modalidades que no sean stroke/stableford/neto
  /// Copia congelada de la categoría del participante EN ESE MOMENTO — no se
  /// actualiza si el participante cambia de categoría después (ver docs).
  categorySnapshot String?
  position         Int?
  status           TournamentResultStatus @default(PROVISIONAL)

  /// Trazabilidad mínima de una corrección posterior a FINAL — sin tabla de
  /// auditoría dedicada todavía (ver Fase E).
  correctedAt      DateTime?
  correctionReason String?

  externalResultId String?

  tournament  Tournament            @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  participant TournamentParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([tournamentId, participantId])
  @@unique([tournamentId, externalResultId])
  @@index([tournamentId, status])
}

// Evolución del hándicap oficial a lo largo del tiempo, un punto por
// actualización real (normalmente tras un torneo).
model HandicapEntry {
  id         String   @id @default(cuid())
  playerId   String
  handicap   Float
  recordedAt DateTime @default(now())
  source     String? // p. ej. "torneo:<id>", "federación", "manual" — texto libre a propósito
  /// Identificador de este cambio en el sistema de origen, si lo hay
  /// (idempotencia de una futura sincronización).
  externalRef String?
  /// Si este valor viene confirmado por una fuente oficial (club/federación)
  /// frente a uno introducido manualmente sin más respaldo — es lo que
  /// permite mostrar "Fuente: oficial" en la UI cuando de verdad corresponda.
  verified    Boolean  @default(false)

  player PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

/// Identidad federativa (licencia) de un jugador — deliberadamente separada
/// de User (nunca acoplada al login) y de PlayerProfile.handicap (una cosa es
/// "quién es oficialmente" y otra "qué hándicap tiene"). Modelo preparado sin
/// ningún proveedor integrado todavía — ver Fase H.
model FederationIdentity {
  id                 String                     @id @default(cuid())
  playerProfileId    String
  /// Nombre de la federación/entidad — texto controlado, no enum cerrado:
  /// no sabemos hoy cuántas fuentes distintas habrá en el futuro.
  federationProvider String
  licenseNumber      String
  verificationStatus LicenseVerificationStatus  @default(UNVERIFIED)
  verifiedAt         DateTime?
  verificationSource String?
  /// Id de esta identidad en el sistema de origen, si lo hay.
  externalId         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  playerProfile PlayerProfile @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)

  // Un jugador no tiene dos licencias registradas de la misma federación...
  @@unique([playerProfileId, federationProvider])
  // ...y una licencia (número dentro de una federación) no puede pertenecer
  // a dos PlayerProfile distintos — unicidad incondicional, no solo cuando
  // verificationStatus = VERIFIED (más simple, sin índice parcial manual;
  // ver documento de especificación, Decisión abierta 6).
  @@unique([federationProvider, licenseNumber])
  @@index([licenseNumber])
}

// Vídeo de swing subido por un jugador (plan Pro). Recibe una puntuación
// automática (estimación heurística a partir de pose estimation en el
// navegador — no un diagnóstico clínico) al instante, y opcionalmente
// feedback escrito de un revisor humano más adelante.
model SwingVideo {
  id       String           @id @default(cuid())
  userId   String
  videoUrl String
  note     String?          @db.Text
  status   SwingVideoStatus @default(PENDING)
  feedback String?          @db.Text

  // Puntuación y métricas automáticas (heurística de biomecánica sobre
  // keypoints extraídos con MediaPipe Pose en el cliente).
  score      Int?
  metrics    Json?
  aiFeedback String? @db.Text

  /// Fase 11D — idempotencia de créditos Swing AI. Lo genera el cliente una
  /// vez por intento de análisis (mismo vídeo + mismo clic en "Analizar" =
  /// mismo id; un archivo distinto o un nuevo intento deliberado = id
  /// nuevo). Único a nivel de BD: un segundo insert con el mismo id
  /// (reintento técnico, o dos requests concurrentes del mismo intento)
  /// nunca crea una segunda fila ni consume un segundo crédito — ver
  /// src/lib/swing/credits.ts.
  analysisRequestId String @unique

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/// Fase 11D — contador atómico de créditos de Swing AI por usuario y
/// periodo natural ("YYYY-MM", igual que CommunityChallenge.month — no el
/// ciclo de facturación exacto de Stripe, misma simplificación ya usada
/// para los minutos de Voice en billing.ts). Una fila por (userId, period);
/// `consumed` solo se incrementa mediante una escritura condicional
/// atómica (`consumed < límite`), nunca con un read-then-write — ver
/// tryConsumeSwingAiCredit en src/lib/swing/credits.ts.
model SwingAiCreditPeriod {
  id       String @id @default(cuid())
  userId   String
  period   String
  consumed Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period])
}

// Registro de duración de cada llamada de voz con el coach — historial/
// auditoría, NO fuente de saldo (ver VoiceCreditPeriod/VoicePurchasedBalance
// más abajo y src/lib/voice/credits.ts, Fase 11E). Se mantiene tal cual
// existía antes de esta fase; solo se le añade `conversationId`.
model VoiceCallLog {
  id              String   @id @default(cuid())
  userId          String
  durationSeconds Int
  createdAt       DateTime @default(now())

  /// Fase 11E — id real de conversación de ElevenLabs (conversation.getId()
  /// del SDK, ver call-coach.tsx). Nullable: las filas históricas anteriores
  /// a esta fase no lo tienen y no se les inventa uno por backfill. Único
  /// cuando existe — es la clave real de idempotencia: un segundo insert
  /// con el mismo conversationId (reintento técnico, o dos requests
  /// concurrentes de la misma llamada) nunca vuelve a descontar saldo.
  conversationId String? @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Fase 11E — minutos INCLUIDOS de Voice por periodo natural ("YYYY-MM",
/// mismo patrón que SwingAiCreditPeriod). Una fila por (userId, period);
/// se crea bajo demanda la primera vez que hace falta, nunca por cron. El
/// límite (FREE/PRO) se deriva del plan actual en src/lib/voice/credits.ts
/// — no se guarda aquí como dato mutable, precisamente para que cambiar de
/// plan no requiera tocar filas ya existentes.
model VoiceCreditPeriod {
  id              String @id @default(cuid())
  userId          String
  period          String
  consumedSeconds Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period])
}

/// Fase 11E — minutos COMPRADOS de Voice (packs de 60 min / 6,99 €, compra
/// única de Stripe, nunca suscripción). Una fila por usuario; nunca caduca
/// ni se reinicia por periodo. Solo crece por una compra confirmada
/// (webhook de Stripe) y solo decrece por consumo real — nunca puede quedar
/// negativo (ver tryConsumeVoiceCredit en src/lib/voice/credits.ts).
model VoicePurchasedBalance {
  id               String @id @default(cuid())
  userId           String @unique
  remainingSeconds Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Campo de golf. Los campos de demostración del prototipo inicial se
// retiraron (ver git history) en cuanto llegó la primera carga de campos
// reales (Mallorca, vía scripts/seed-mallorca-golf.mjs) — ya no existe
// ningún dato inventado en esta tabla.
//
// `holes` (GolfCourseHole) es y sigue siendo el único juego de hoyos que
// usan /play/new y createGame para crear una partida — no se toca en esta
// fase. `layouts` es la estructura NUEVA y en paralelo (Campo → Recorrido
// → Tee → Hoyo) para cuando un campo tenga varios recorridos (Santa
// Ponsa I/II/III, Son Antem Este/Oeste...) y varios tees con su propio
// Course Rating/Slope/distancias — todavía sin ningún caller: no cambia
// nada de lo que ya funciona hasta que se conecte explícitamente.
model GolfCourse {
  id       String  @id @default(cuid())
  name     String
  location String?
  /// Isla (p. ej. "Mallorca") — opcional, solo se rellena cuando se
  /// verifica; no se infiere del nombre.
  island   String?
  /// País (p. ej. "España") — opcional, mismo criterio que `island`.
  country  String?
  /// Identificador estable para importadores idempotentes (seed de
  /// Mallorca, y futuros de España/Europa/resto del mundo) — permite
  /// volver a ejecutar el mismo seed sin crear duplicados.
  slug     String? @unique

  createdAt DateTime @default(now())

  holes       GolfCourseHole[]
  layouts     GolfCourseLayout[]
  games       Game[]
  tournaments Tournament[]
}

/// Un recorrido jugable dentro de un campo — la mayoría de campos solo
/// tienen uno ("Recorrido 18"), pero algunos tienen varios recorridos
/// independientes bajo el mismo club (p. ej. Santa Ponsa I/II/III, Son
/// Antem Este/Oeste). /play/new lee esta estructura (no GolfCourse.holes)
/// para campos reales; ver createGame en actions/games.ts.
model GolfCourseLayout {
  id        String  @id @default(cuid())
  courseId  String
  name      String
  holeCount Int?

  createdAt DateTime @default(now())

  course GolfCourse      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tees   GolfCourseTee[]
  games  Game[]

  @@unique([courseId, name])
}

/// Un tee (color/salida) dentro de un recorrido, con sus propios totales
/// oficiales — nunca compartidos ni copiados de otro tee. Cualquier dato
/// no verificado se deja NULL en vez de aproximarlo.
model GolfCourseTee {
  id            String @id @default(cuid())
  layoutId      String
  name          String
  /// Sexo/categoría del tee cuando la fuente lo publica (p. ej. "M", "F")
  /// — NULL cuando la fuente no lo especifica, nunca deducido.
  category      String?
  parTotal      Int?
  distanceTotal Int?
  /// Course Rating oficial de la RFEG para este tee, si está publicado.
  courseRating  Float?
  /// Slope oficial de la RFEG para este tee, si está publicado.
  slope         Int?

  createdAt DateTime @default(now())

  layout GolfCourseLayout    @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  holes  GolfCourseTeeHole[]
  games  Game[]

  // Algunos recorridos (p. ej. Palma Pitch & Putt) publican el mismo
  // nombre de tee ("VERDES") con dos valoraciones oficiales distintas por
  // categoría (Hombres/Mujeres) — la clave de unicidad incluye `category`
  // para que ambas convivan como filas separadas en vez de pisarse.
  @@unique([layoutId, name, category])
}

/// Detalle hoyo a hoyo de UN tee concreto — cada tee tiene su propia fila
/// por hoyo (par/stroke index/distancia pueden variar entre tees del
/// mismo recorrido), nunca se comparte entre tees.
model GolfCourseTeeHole {
  id       String @id @default(cuid())
  teeId    String
  number   Int
  par      Int?
  index    Int?
  distance Int?

  tee GolfCourseTee @relation(fields: [teeId], references: [id], onDelete: Cascade)

  @@unique([teeId, number])
}

model GolfCourseHole {
  id       String @id @default(cuid())
  courseId String
  number   Int
  par      Int
  index    Int?
  distance Int?

  course GolfCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, number])
}

// Una partida de golf: solitaria (modo SOLO, el uso original de la app) o
// multijugador. Cada jugador —incluido el creador— tiene su propia fila en
// GamePlayer (así es como un amigo invitado se convierte en un usuario
// real de la app), pero los golpes se registran en un scorecard
// compartido: cualquier jugador de la partida puede anotar el hoyo por
// todo el grupo desde su propio móvil — no hace falta que cada uno saque
// el suyo (ver saveHoleScores en actions/games.ts).
//
// started=false mientras la partida está en el "lobby" (uniéndose
// amigos, eligiendo apuesta, check-in mental opcional) — al pulsar
// "Empezar partida" pasa a true y arranca el Focus Mode sin más chrome
// que el scorecard.
model Game {
  id             String     @id @default(cuid())
  courseId       String?
  course         String
  /// Recorrido (GolfCourseLayout) elegido al crear la partida, si el campo
  /// es uno de los reales con estructura de recorridos/tees. NULL para
  /// partidas con campo en texto libre o partidas anteriores a esta
  /// función — nunca se rellena a posteriori.
  courseLayoutId String?
  /// Tee (GolfCourseTee) elegido al crear la partida. Igual que
  /// courseLayoutId, opcional y solo se fija en el momento de crear.
  courseTeeId    String?
  /// Foto del nombre del recorrido en el momento de crear la partida —
  /// independiente de que GolfCourseLayout cambie o se borre después.
  layoutName     String?
  /// Foto del nombre del tee (color) en el momento de crear la partida.
  teeName        String?
  /// Foto de la categoría del tee (p. ej. "M"/"F"), si tenía una.
  teeCategory    String?
  /// Foto del Course Rating oficial del tee, si estaba publicado.
  teeCourseRating Float?
  /// Foto del Slope oficial del tee, si estaba publicado.
  teeSlope       Int?
  /// Foto del par total del tee (GolfCourseTee.parTotal) en el momento de crear.
  teeParTotal    Int?
  /// Número real de hoyos del tee (9 o 18) — distinto de totalHoles, que es
  /// cuántos hoyos se JUEGAN en esta partida (un recorrido de 9 puede
  /// jugarse a 18 repitiendo la vuelta). Necesario para saber si el
  /// hándicap de esta partida corresponde a una valoración de 9 hoyos
  /// real del tee o exige una de 18 que no tenemos.
  teeHoleCount   Int?
  /// Handicap Index declarado por el creador en el momento de crear la
  /// partida — foto, nunca se recalcula después aunque el jugador
  /// actualice su Handicap Index más tarde.
  handicapIndex     Float?
  /// Course Handicap del creador para este tee (Handicap Index × Slope/113
  /// + (Course Rating − Par), sin redondear a 54). Null si el tee no tiene
  /// Course Rating/Slope verificados.
  courseHandicap    Int?
  /// Playing Handicap del creador = Course Handicap × handicapAllowance.
  playingHandicap   Int?
  /// Allowance aplicado (1.0 = 100%, stroke play individual en esta fase).
  handicapAllowance Float?
  mode           GameMode
  playerCount    Int        @default(1)
  started        Boolean    @default(false)
  date           DateTime
  totalHoles     Int        @default(18)
  goal           String?
  bet            String?    @db.Text
  status         GameStatus @default(IN_PROGRESS)
  insight        String?    @db.Text
  inviteCode     String     @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  golfCourse       GolfCourse?       @relation(fields: [courseId], references: [id])
  golfCourseLayout GolfCourseLayout? @relation(fields: [courseLayoutId], references: [id], onDelete: SetNull)
  golfCourseTee    GolfCourseTee?    @relation(fields: [courseTeeId], references: [id], onDelete: SetNull)
  holes            Hole[]
  players          GamePlayer[]
  moodEntries      MoodEntry[]
  messages         Message[]
  challengeWins    ChallengeWin[]

  @@index([date])
}

// Un jugador dentro de una partida. userId + gameId es único: no puedes
// unirte dos veces a la misma partida.
model GamePlayer {
  id     String @id @default(cuid())
  gameId String
  userId String
  team   Team?

  /// Foto del Handicap Index de ESTE jugador en el momento de incorporarse
  /// a la partida (al crearla, en una revancha, o al unirse por código de
  /// invitación) — nunca se recalcula después si el jugador actualiza su
  /// Handicap Index más tarde. Fuente de verdad del hándicap por jugador;
  /// los campos equivalentes en Game representan solo al creador y se
  /// mantienen por compatibilidad.
  handicapIndex     Float?
  /// Foto del Course Handicap de este jugador para el tee de esta partida.
  courseHandicap    Int?
  /// Foto del Playing Handicap de este jugador (Course Handicap × allowance).
  playingHandicap   Int?
  /// Foto del allowance aplicado (1.0 = 100%, stroke play individual en esta fase).
  handicapAllowance Float?

  joinedAt DateTime @default(now())

  game   Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  scores Score[]

  @@unique([gameId, userId])
  @@index([gameId])
}

model Hole {
  id       String @id @default(cuid())
  gameId   String
  number   Int
  par      Int
  distance Int?
  index    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  game        Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  moodEntries MoodEntry[]
  scores      Score[]

  @@unique([gameId, number])
}

// Golpes de UN jugador en UN hoyo. Antes vivía como columnas sueltas en
// Hole (solo servía para partidas de un jugador); ahora cada GamePlayer
// tiene su propia fila por hoyo, lo que permite partidas multijugador.
model Score {
  id       String @id @default(cuid())
  holeId   String
  playerId String
  strokes  Int?
  putts    Int?
  club     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hole   Hole       @relation(fields: [holeId], references: [id], onDelete: Cascade)
  player GamePlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  shots  Shot[]

  @@unique([holeId, playerId])
}

/**
 * Golpe individual dentro de un hoyo (Drive 248m, Hierro 7 132m...) — capa
 * de detalle opcional sobre Score. Score.strokes se mantiene en sync como
 * el recuento de Shot de ese Score (ver actions/games.ts addShot/removeShot),
 * así que todo lo que ya lee Score.strokes (standings, resumen, hándicap)
 * sigue funcionando sin cambios.
 */
model Shot {
  id             String  @id @default(cuid())
  scoreId        String
  club           String
  distanceMeters Int?
  sequence       Int

  createdAt DateTime @default(now())

  score Score @relation(fields: [scoreId], references: [id], onDelete: Cascade)

  @@index([scoreId])
}

// Reto opcional marcado manualmente durante la partida (más cercano a
// bandera, drive más preciso, mejor putt...). Sin detección automática
// por GPS: lo marca un jugador o el creador de la partida.
model ChallengeWin {
  id           String  @id @default(cuid())
  gameId       String
  challengeKey String
  playerId     String
  holeId       String?

  createdAt DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
}

model MoodEntry {
  id     String  @id @default(cuid())
  userId String
  gameId String?
  holeId String?

  mood Mood
  note String? @db.Text

  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game? @relation(fields: [gameId], references: [id], onDelete: Cascade)
  hole Hole? @relation(fields: [holeId], references: [id], onDelete: Cascade)

  @@index([gameId, createdAt])
  @@index([userId, createdAt])
}

// El chat/llamada con el compañero. gameId es opcional: MIND funciona
// también fuera de una partida activa (ver /mind), no solo dentro de ella.
model Message {
  id     String  @id @default(cuid())
  userId String
  gameId String?

  role    MessageRole
  content String      @db.Text

  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game? @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId, createdAt])
  @@index([userId, createdAt])
}

// Historias reales compartidas por jugadores de la app (no contenido
// generado ni atribuido a golfistas reales externos — ver README).
model Story {
  id       String        @id @default(cuid())
  userId   String
  title    String
  content  String        @db.Text
  category StoryCategory @default(GENERAL)

  createdAt DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes    Like[]
  comments Comment[]

  @@index([createdAt])
  @@index([category, createdAt])
}

enum StoryCategory {
  GENERAL
  CAMPO
  CONSEJO
}

model Like {
  id        String   @id @default(cuid())
  storyId   String
  userId    String
  createdAt DateTime @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
  @@index([storyId])
}

model Comment {
  id        String   @id @default(cuid())
  storyId   String
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([storyId, createdAt])
}

// Un reto comunitario por mes ("Reto del mes" en Comunidad). El progreso
// mostrado es real: cuántos jugadores se han unido frente al objetivo de
// participantes — nunca un porcentaje de mejora individual inventado, que
// necesitaría trackear hándicap histórico por jugador (fuera de alcance).
model CommunityChallenge {
  id                 String   @id @default(cuid())
  month              String // "2026-09"
  title              String
  description        String   @db.Text
  targetParticipants Int
  createdAt          DateTime @default(now())

  participants ChallengeParticipant[]

  @@unique([month])
}

model ChallengeParticipant {
  id          String   @id @default(cuid())
  challengeId String
  userId      String
  joinedAt    DateTime @default(now())

  challenge CommunityChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([challengeId])
}
