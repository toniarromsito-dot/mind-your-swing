// Mind Your Swing — Prisma schema
// Postgres in production; see README for local dev options.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth.js (NextAuth) models ----------
// Required shape for @auth/prisma-adapter.

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Domain models ----------

// Cómo se comunica el compañero. Reemplaza al antiguo CERCANO/FORMAL: el
// producto ahora se vende como "tu compañero de golf", así que las
// personalidades son más expresivas que un simple tono formal/informal.
enum CoachTone {
  CALM
  MOTIVATOR
  COACH
  FRIEND
}

enum GameStatus {
  IN_PROGRESS
  COMPLETED
}

// Modos de juego. Uno por concepto, no uno por número de jugadores: la
// misma FRIENDLY_CHALLENGE es "Reto amistoso" a 2, "Mini retos" a 3 y
// "Retos amistosos" a 4 — solo cambia la etiqueta (ver dictionaries.ts),
// no la lógica (ver src/lib/games/standings.ts).
enum GameMode {
  SOLO
  STROKE_PLAY
  MATCH_PLAY
  DUEL
  FRIENDLY_CHALLENGE
  EVERYONE_VS_EVERYONE
  POINTS
  TWO_VS_TWO
  BEST_BALL
  SCRAMBLE
  TEAM_DUEL
}

enum Team {
  A
  B
}

enum Mood {
  TRANQUILO
  NERVIOSO
  FRUSTRADO
  CONFIADO
  CONCENTRADO
}

enum MessageRole {
  USER
  ASSISTANT
}

enum Plan {
  FREE
  PRO
}

enum SwingVideoStatus {
  PENDING
  REVIEWED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  handicap  Float?
  coachTone CoachTone @default(FRIEND)
  language  String    @default("es")

  // Suscripción / Stripe
  plan                     Plan      @default(FREE)
  stripeCustomerId         String?   @unique
  stripeSubscriptionId     String?   @unique
  stripeSubscriptionStatus String?
  currentPeriodEnd         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts      Account[]
  sessions      Session[]
  gamePlayers   GamePlayer[]
  moodEntries   MoodEntry[]
  messages      Message[]
  stories       Story[]
  voiceCallLogs VoiceCallLog[]
  swingVideos   SwingVideo[]
}

// Vídeo de swing subido por un jugador (plan Pro). Recibe una puntuación
// automática (estimación heurística a partir de pose estimation en el
// navegador — no un diagnóstico clínico) al instante, y opcionalmente
// feedback escrito de un revisor humano más adelante.
model SwingVideo {
  id       String           @id @default(cuid())
  userId   String
  videoUrl String
  note     String?          @db.Text
  status   SwingVideoStatus @default(PENDING)
  feedback String?          @db.Text

  // Puntuación y métricas automáticas (heurística de biomecánica sobre
  // keypoints extraídos con MediaPipe Pose en el cliente).
  score      Int?
  metrics    Json?
  aiFeedback String? @db.Text

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// Registro de duración de cada llamada de voz con el coach, para aplicar
// los minutos incluidos en cada plan (ver src/lib/billing.ts).
model VoiceCallLog {
  id              String   @id @default(cuid())
  userId          String
  durationSeconds Int
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Campo de golf. isDemo=true marca explícitamente que son datos de
// demostración para el prototipo, nunca datos reales inventados — ver
// README, la integración con una API real de campos queda para más
// adelante.
model GolfCourse {
  id       String  @id @default(cuid())
  name     String
  location String?
  isDemo   Boolean @default(true)

  createdAt DateTime @default(now())

  holes GolfCourseHole[]
  games Game[]
}

model GolfCourseHole {
  id       String @id @default(cuid())
  courseId String
  number   Int
  par      Int
  index    Int?
  distance Int?

  course GolfCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, number])
}

// Una partida de golf: solitaria (modo SOLO, el uso original de la app)
// o multijugador. Cada jugador —incluido el creador— tiene su propia fila
// en GamePlayer, y cada uno introduce sus propios golpes (Score) desde su
// propia sesión: así es como un amigo invitado se convierte en un usuario
// real de la app en vez de que el creador teclee por todos.
model Game {
  id          String     @id @default(cuid())
  courseId    String?
  course      String
  mode        GameMode
  playerCount Int        @default(1)
  date        DateTime
  totalHoles  Int        @default(18)
  goal        String?
  status      GameStatus @default(IN_PROGRESS)
  insight     String?    @db.Text
  inviteCode  String     @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  golfCourse    GolfCourse?    @relation(fields: [courseId], references: [id])
  holes         Hole[]
  players       GamePlayer[]
  moodEntries   MoodEntry[]
  messages      Message[]
  challengeWins ChallengeWin[]

  @@index([date])
}

// Un jugador dentro de una partida. userId + gameId es único: no puedes
// unirte dos veces a la misma partida.
model GamePlayer {
  id     String @id @default(cuid())
  gameId String
  userId String
  team   Team?

  joinedAt DateTime @default(now())

  game   Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  scores Score[]

  @@unique([gameId, userId])
  @@index([gameId])
}

model Hole {
  id       String @id @default(cuid())
  gameId   String
  number   Int
  par      Int
  distance Int?
  index    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  game        Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  moodEntries MoodEntry[]
  scores      Score[]

  @@unique([gameId, number])
}

// Golpes de UN jugador en UN hoyo. Antes vivía como columnas sueltas en
// Hole (solo servía para partidas de un jugador); ahora cada GamePlayer
// tiene su propia fila por hoyo, lo que permite partidas multijugador.
model Score {
  id       String @id @default(cuid())
  holeId   String
  playerId String
  strokes  Int?
  putts    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hole   Hole       @relation(fields: [holeId], references: [id], onDelete: Cascade)
  player GamePlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([holeId, playerId])
}

// Reto opcional marcado manualmente durante la partida (más cercano a
// bandera, drive más preciso, mejor putt...). Sin detección automática
// por GPS: lo marca un jugador o el creador de la partida.
model ChallengeWin {
  id           String  @id @default(cuid())
  gameId       String
  challengeKey String
  playerId     String
  holeId       String?

  createdAt DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
}

model MoodEntry {
  id     String  @id @default(cuid())
  userId String
  gameId String?
  holeId String?

  mood Mood
  note String? @db.Text

  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game? @relation(fields: [gameId], references: [id], onDelete: Cascade)
  hole Hole? @relation(fields: [holeId], references: [id], onDelete: Cascade)

  @@index([gameId, createdAt])
  @@index([userId, createdAt])
}

// El chat/llamada con el compañero. gameId es opcional: MIND funciona
// también fuera de una partida activa (ver /mind), no solo dentro de ella.
model Message {
  id     String  @id @default(cuid())
  userId String
  gameId String?

  role    MessageRole
  content String      @db.Text

  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game? @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId, createdAt])
  @@index([userId, createdAt])
}

// Historias reales compartidas por jugadores de la app (no contenido
// generado ni atribuido a golfistas reales externos — ver README).
model Story {
  id      String @id @default(cuid())
  userId  String
  title   String
  content String @db.Text

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}
