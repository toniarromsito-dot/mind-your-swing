# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.test

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local dev database (embedded-postgres, no Docker/admin required)
/.local-postgres/

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# neon CLI (local project link + generated agent skill docs)
.neon
/.claude/skills/
/skills-lock.json

.env*
.vercel

# Claude Code scratch files (throwaway debug/verification scripts, not source)
/.claude/scratchpad/

# IDE project settings
.idea/

# built app binaries (delivered ad hoc, not app assets — not served from public/)
*.apk
*.aab

# Fase 12E — firma de release de Android: NUNCA se commitea una keystore
# real ni sus credenciales. android/keystore.properties.example (sí
# versionado) documenta el formato esperado.
/android/keystore.properties
/android/*.keystore
/android/*.jks
