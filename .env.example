# Copia este archivo como .env y rellena los valores.
# Ver README.md → "Configuración" para instrucciones paso a paso.

# Cadena de conexión a Postgres.
# Local con el script incluido (sin Docker): postgresql://postgres:postgres@localhost:5544/mindyourswing
# Producción (Neon/Supabase): la que te den ellos, normalmente con ?sslmode=require
DATABASE_URL=

# URL pública de la app. En local: http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Secreto para firmar las sesiones de Auth.js. Genéralo con: npx auth secret
# o con: openssl rand -base64 32
NEXTAUTH_SECRET=

# Credenciales OAuth de Google (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# API key de Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Modelo de Claude a usar para el coach. Configurable sin tocar código.
ANTHROPIC_MODEL=claude-sonnet-4-5

# Solo necesario si tu API key no está asociada a un workspace concreto
# (la consola de Anthropic devolverá un error "not scoped to a workspace"
# si hace falta). Encuéntralo en console.anthropic.com → Settings → Workspaces.
ANTHROPIC_WORKSPACE_ID=

# Voz del coach al escribir (opcional). Sin esto, el chat funciona igual pero sin audio.
# API key: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# ID de voz opcional (https://elevenlabs.io/app/voice-library). Por defecto
# usa "Rachel", una voz pública en inglés/multilingüe de ElevenLabs.
ELEVENLABS_VOICE_ID=

# Llamada de voz en tiempo real (opcional, distinto de lo anterior). Requiere
# crear un agente de "Conversational AI" en ElevenLabs configurado con un
# Custom LLM apuntando a https://<tu-dominio>/api/voice/v1/chat/completions.
# Ver README → "Llamada de voz en tiempo real" para la guía completa.
ELEVENLABS_AGENT_ID=
# Secreto compartido que verifica que las llamadas a /api/voice/v1/chat/completions
# vienen de ElevenLabs. Genéralo con: openssl rand -hex 32
# (debe coincidir con el secreto configurado como api_key del Custom LLM en ElevenLabs)
ELEVENLABS_CUSTOM_LLM_SECRET=

# Suscripción de pago (opcional). Sin esto, la app funciona igual pero todo
# el mundo se queda en el plan Gratis — el botón de "Pasar a Pro" avisa de
# que los pagos no están configurados. Ver README → "Suscripción (Stripe)".
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
# Lo genera Stripe al crear el webhook (dashboard.stripe.com/webhooks o `stripe listen`)
STRIPE_WEBHOOK_SECRET=

# Revisión manual de vídeos de swing (opcional). Emails separados por comas
# que pueden ver /admin/videos y escribir feedback manual sobre la
# puntuación automática. Sin esto, nadie puede acceder a esa página.
ADMIN_EMAILS=

# Cuentas propietarias/desarrolladoras (opcional). Emails separados por
# comas que obtienen acceso Pro completo e ilimitado sin pasar por Stripe
# (ver src/lib/plan.ts) — para desarrollar y enseñar el producto sin
# necesitar una suscripción activa. Un owner es también admin automáticamente.
OWNER_EMAILS=
