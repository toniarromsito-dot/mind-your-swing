# Copia este archivo como .env y rellena los valores.
# Ver README.md → "Configuración" para instrucciones paso a paso.

# Cadena de conexión a Postgres.
# Local con el script incluido (sin Docker): postgresql://postgres:postgres@localhost:5544/mindyourswing
# Producción (Neon/Supabase): la que te den ellos, normalmente con ?sslmode=require
DATABASE_URL=

# URL pública de la app. En local: http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Secreto para firmar las sesiones de Auth.js. Genéralo con: npx auth secret
# o con: openssl rand -base64 32
NEXTAUTH_SECRET=

# Credenciales OAuth de Google (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mismo valor que GOOGLE_CLIENT_ID de arriba, expuesto al bundle del cliente
# (prefijo NEXT_PUBLIC_) — lo usa el login nativo de Android (Credential
# Manager, ver src/components/native-app-init.tsx) para identificar el
# proyecto de Google ante Play Services. Además hace falta un OAuth Client
# de tipo "Android" (paquete com.mindyourswing.app + huella SHA-1 del
# certificado de firma) dado de alta en el MISMO proyecto de Google Cloud
# — ese client ID no se usa en ningún sitio del código, pero su sola
# existencia en el proyecto es lo que autoriza a la app a usarlo.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Iniciar sesión con Apple (opcional en la web, OBLIGATORIO para publicar en
# la App Store — norma 4.8, porque la app ofrece login con Google). Sin estas
# dos variables el botón de Apple no aparece y el provider no se registra.
# En developer.apple.com: App ID con "Sign In with Apple" + un Services ID
# (ese identificador va en AUTH_APPLE_ID) con dominio mind-your-swing.vercel.app
# y Return URL https://mind-your-swing.vercel.app/api/auth/callback/apple, y
# una clave .p8 de Sign In with Apple. AUTH_APPLE_SECRET es el client secret
# JWT firmado con esa clave — genéralo con: npx auth add apple
# (caduca como máximo a los 6 meses: hay que regenerarlo antes).
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# API key de Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Modelo de Claude a usar para el coach. Configurable sin tocar código.
ANTHROPIC_MODEL=claude-sonnet-4-5

# Solo necesario si tu API key no está asociada a un workspace concreto
# (la consola de Anthropic devolverá un error "not scoped to a workspace"
# si hace falta). Encuéntralo en console.anthropic.com → Settings → Workspaces.
ANTHROPIC_WORKSPACE_ID=

# Voz del coach al escribir (opcional). Sin esto, el chat funciona igual pero sin audio.
# API key: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# ID de voz opcional (https://elevenlabs.io/app/voice-library). Por defecto
# usa "Rachel", una voz pública en inglés/multilingüe de ElevenLabs.
ELEVENLABS_VOICE_ID=

# Llamada de voz en tiempo real (opcional, distinto de lo anterior). Requiere
# crear un agente de "Conversational AI" en ElevenLabs configurado con un
# Custom LLM apuntando a https://<tu-dominio>/api/voice/v1/chat/completions.
# Ver README → "Llamada de voz en tiempo real" para la guía completa.
ELEVENLABS_AGENT_ID=
# Secreto compartido que verifica que las llamadas a /api/voice/v1/chat/completions
# vienen de ElevenLabs. Genéralo con: openssl rand -hex 32
# (debe coincidir con el secreto configurado como api_key del Custom LLM en ElevenLabs)
ELEVENLABS_CUSTOM_LLM_SECRET=

# Suscripción de pago (opcional). Sin esto, la app funciona igual pero todo
# el mundo se queda en el plan Gratis — los botones de upgrade avisan de que
# los pagos no están configurados. Ver README → "Suscripción (Stripe)".
STRIPE_SECRET_KEY=
# Un Price ID de tipo "recurring" por cada intervalo (14,99 €/mes y
# 143,90 €/año — crear ambos como Price distintos del mismo Product en
# Stripe).
STRIPE_PRO_PRICE_ID_MONTHLY=
STRIPE_PRO_PRICE_ID_ANNUAL=
# Pack de Voice (opcional) — 60 minutos extra por 6,99€, compra única (no
# suscripción). Un Price de tipo "one_time" en Stripe, sobre el mismo o
# distinto Product. Sin esto, el CTA de comprar minutos avisa de que no
# está configurado; el resto de Voice (minutos incluidos por plan) funciona igual.
STRIPE_VOICE_PACK_PRICE_ID=
# Lo genera Stripe al crear el webhook (dashboard.stripe.com/webhooks o `stripe listen`)
STRIPE_WEBHOOK_SECRET=

# Revisión manual de vídeos de swing (opcional). Emails separados por comas
# que pueden ver /admin/videos y escribir feedback manual sobre la
# puntuación automática. Sin esto, nadie puede acceder a esa página.
ADMIN_EMAILS=

# Cuentas propietarias/desarrolladoras (opcional). Emails separados por
# comas que obtienen acceso Pro completo e ilimitado sin pasar por Stripe
# (ver src/lib/plan.ts) — para desarrollar y enseñar el producto sin
# necesitar una suscripción activa. Un owner es también admin automáticamente.
OWNER_EMAILS=

# Banner de AdMob para usuarios FREE en la app nativa (opcional — Fase 11F).
# Sin esto, el sistema de anuncios queda inerte: nunca se llama a AdMob, en
# ninguna plataforma (ver src/lib/ads/config.ts). No son secretos — Google
# diseña los Ad Unit ID para ir embebidos en el cliente — pero deben ser
# IDs REALES de tu cuenta de AdMob (console.admob.google.com), nunca
# inventados. Además, cada plataforma requiere su propio AdMob App ID dado
# de alta en AndroidManifest.xml (android/app/src/main/AndroidManifest.xml,
# meta-data com.google.android.gms.ads.APPLICATION_ID) e Info.plist
# (ios/App/App/Info.plist, GADApplicationIdentifier) — configuración nativa
# que este repo NO incluye todavía. Ver README → "Publicidad (AdMob)".
NEXT_PUBLIC_ADMOB_BANNER_AD_UNIT_ID_ANDROID=
NEXT_PUBLIC_ADMOB_BANNER_AD_UNIT_ID_IOS=

# RevenueCat — billing nativo de PRO en iOS/Android vía App Store/Google
# Play (opcional — Fase 12C, fundación multi-provider). Sin esto, la
# integración queda inerte: el SDK nunca se configura en ninguna
# plataforma (ver src/lib/revenuecat-client.ts) y el webhook responde 503
# (ver src/lib/revenuecat.ts). Stripe (web) sigue funcionando exactamente
# igual, sin ninguna dependencia de estas variables.
#
# API keys públicas de RevenueCat (una por plataforma, del proyecto en
# app.revenuecat.com) — no son secretas, están pensadas para ir en el
# cliente, pero deben ser las REALES de tu proyecto, nunca inventadas.
NEXT_PUBLIC_REVENUECAT_API_KEY_IOS=
NEXT_PUBLIC_REVENUECAT_API_KEY_ANDROID=
# Secreto de firma HMAC del webhook (RevenueCat Dashboard → Integrations →
# Webhooks → tu integración → "Enable signature verification"). Se muestra
# una sola vez al crearlo — guárdalo, no se puede recuperar después.
REVENUECAT_WEBHOOK_SECRET=
