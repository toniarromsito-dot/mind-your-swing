# Fase 12E — plantilla, NO credenciales reales. Copiar a
# android/keystore.properties (mismo directorio, ya en .gitignore — nunca
# se commitea) y rellenar con los datos reales de la keystore de release
# cuando exista. Sin este archivo, android/app/build.gradle simplemente no
# firma la build de release (assembleDebug no se ve afectado en absoluto).
#
# storeFile es relativo a android/app/ (el mismo directorio que build.gradle).
storeFile=../release.keystore
storePassword=CHANGE_ME
keyAlias=CHANGE_ME
keyPassword=CHANGE_ME
