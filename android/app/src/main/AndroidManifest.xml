<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link de vuelta desde /mobile-bridge tras el login de
                 Google en el navegador del sistema — ver NativeAppInit. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mindyourswing" />
            </intent-filter>

            <!-- Fase 12E — Android App Links: enlaces reales de invitación a
                 partida (https://mind-your-swing.vercel.app/play/join/...,
                 ver src/lib/games/invite.ts) abren la app instalada en vez
                 del navegador. Deliberadamente en un intent-filter SEPARADO
                 del custom-scheme de arriba (buena práctica: mezclar
                 autoVerify con un esquema no-https en el mismo filtro puede
                 romper la verificación de ambos). autoVerify requiere que
                 public/.well-known/assetlinks.json publique el SHA-256 real
                 del certificado de firma de producción — ese archivo existe
                 ya en este repo con un valor placeholder explícito hasta
                 que exista una keystore de release real (ver
                 docs/mobile-release-checklist.md). Hasta entonces, Android
                 no completará la verificación y estos enlaces se abrirán en
                 el navegador como hasta ahora — no es una regresión. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="mind-your-swing.vercel.app"
                    android:pathPrefix="/play/join" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Fase 12D.1 — Coach de voz (call-coach.tsx) llama a
         getUserMedia({ audio: true }) dentro del WebView. Sin este permiso
         declarado, WebChromeClient.onPermissionRequest no puede conceder
         PermissionRequest.RESOURCE_AUDIO_CAPTURE y la llamada de voz nunca
         consigue micrófono en Android nativo. Deliberadamente NO se añade
         CAMERA ni READ_MEDIA_IMAGES/VIDEO — la app no abre cámara en vivo
         en ningún sitio (grep de getUserMedia/capture= en todo src/
         confirma un único uso, solo audio) y la subida de vídeo de Swing AI
         usa un <input accept="video/*"> sin capture, que abre el selector
         del sistema (Photo Picker) sin necesitar permisos declarados. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
</manifest>
